<#macro hero>
        <section class="hero" aria-labelledby="title">
          <div class="hero-paper">
            <h1 id="title">frmtr</h1>
            <p class="hero-summary">
              Fast Java formatting, width-aware output, and diagnostics that stay attached to the file.
            </p>
          </div>

          <div class="hero-dark">
            <div class="specimen">
              <p class="specimen-word">DIFF<br>LESS</p>
              <div class="specimen-copy">
                <p class="eyebrow">Java format tooling</p>
                <p class="copy">
                  <code>frmtr</code> parses Java source, prints a formatter-owned document tree, and renders stable
                  source with deliberate line breaks.
                </p>
                <a class="command" href="#setup">./gradlew frmtrCheck</a>
              </div>
            </div>
            <aside class="yellow-panel" aria-label="Formatter default">
              <p class="eyebrow">Default width</p>
              <span class="stamp">120</span>
              <p>No config block is required for ordinary Java source sets.</p>
            </aside>
          </div>
        </section>
</#macro>
